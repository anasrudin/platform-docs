{#
  haproxy.cfg.j2 — Jinja2 template for HAProxy configuration.

  Rendered at deploy time (e.g., by Ansible or Nomad template stanza) with:
    agents   — list of dicts: {id, address, port, tier}
    bind_port — port HAProxy listens on (default: 80)
    stats_port — stats socket port (default: 8404)

  For dynamic runtime reloading, use haproxy.cfg.ctmpl + consul-template.hcl
  instead (consul-template re-renders when Consul services change).
#}
global
    maxconn 4096
    log stdout format raw local0 info
    stats socket /var/run/haproxy/admin.sock mode 660 level admin expose-fd listeners

defaults
    mode http
    log global
    option httplog
    option dontlognull
    option forwardfor
    option http-server-close
    timeout connect 5s
    timeout client  30s
    timeout server  30s
    retries 3

# ── Stats ───────────────────────────────────────────────────────────────────────
frontend stats
    bind *:{{ stats_port | default(8404) }}
    stats enable
    stats uri /stats
    stats refresh 10s
    stats admin if LOCALHOST

# ── Frontend ───────────────────────────────────────────────────────────────────
frontend sandbox_api
    bind *:{{ bind_port | default(80) }}
    default_backend sandbox_wasm

    # Route by X-Runtime header or URL prefix
    acl is_microvm hdr(X-Runtime) -i microvm
    acl is_gui     hdr(X-Runtime) -i gui
    use_backend sandbox_microvm if is_microvm
    use_backend sandbox_gui     if is_gui

# ── WASM backend ───────────────────────────────────────────────────────────────
backend sandbox_wasm
    balance leastconn
    option httpchk GET /health
    http-check expect status 200
    default-server inter 10s fall 3 rise 2 slowstart 30s
{% for agent in agents | selectattr("tier", "equalto", "wasm") %}
    server {{ agent.id }} {{ agent.address }}:{{ agent.port }} check
{% else %}
    # No wasm agents registered
{% endfor %}

# ── Firecracker (microVM) backend ──────────────────────────────────────────────
backend sandbox_microvm
    balance leastconn
    option httpchk GET /health
    http-check expect status 200
    default-server inter 10s fall 3 rise 2 slowstart 60s
{% for agent in agents | selectattr("tier", "equalto", "microvm") %}
    server {{ agent.id }} {{ agent.address }}:{{ agent.port }} check
{% else %}
    # No microvm agents registered
{% endfor %}

# ── GUI backend ────────────────────────────────────────────────────────────────
backend sandbox_gui
    balance leastconn
    option httpchk GET /health
    http-check expect status 200
    default-server inter 10s fall 3 rise 2 slowstart 30s
{% for agent in agents | selectattr("tier", "equalto", "gui") %}
    server {{ agent.id }} {{ agent.address }}:{{ agent.port }} check
{% else %}
    # No gui agents registered
{% endfor %}
