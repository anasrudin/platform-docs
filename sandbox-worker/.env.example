# sandbox-worker/.env.example
# Copy ke .env: cp .env.example .env
# Semua nilai di sini adalah default untuk dev lokal.
# JANGAN commit .env — sudah ada di .gitignore

# ── API Server ─────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=1
DEV_MODE=true            # true = human-readable logs

# ── Firecracker ────────────────────────────────────────────────────────────────────
FC_MODE=sim              # sim = aman untuk macOS (tidak butuh /dev/kvm)
                         # real = butuh Linux + /dev/kvm
                         # "" = auto-detect berdasarkan /dev/kvm
FC_POOL_SIZE=2
FC_DEV_MODE=false
FC_BINARY_PATH=/usr/bin/firecracker
FC_KERNEL_PATH=/opt/platform/vmlinux
FC_ROOTFS_PATH=/opt/platform/rootfs.ext4
FC_VSOCK_CID_BASE=100
FC_SNAPSHOT_BUCKET=platform-snapshots

# ── WASM ───────────────────────────────────────────────────────────────────────────
WASM_MODE=sim            # sim = tidak butuh wasmtime binary
                         # real = butuh wasmtime installed
                         # "" = auto-detect
WASM_MODULE_DIR=/opt/platform/wasm

# ── GUI (Chromium) ─────────────────────────────────────────────────────────────────
GUI_MODE=sim             # sim | real | ""
CHROME_PATH=/usr/bin/chromium-browser
VNC_PORT_BASE=5900

# ── Redis ──────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_PREFIX=session:
REDIS_SESSION_TTL=3600

# ── PostgreSQL ─────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/platform?sslmode=disable

# ── Storage (Artifact) — MinIO / S3 ────────────────────────────────────────────────
STORAGE_DRIVER=minio     # minio | local | s3 | gcs
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=platform-artifacts
ARTIFACTS_LOCAL_DIR=     # kosong = fallback local dir

# ── Packages ───────────────────────────────────────────────────────────────────────
PACKAGES_LOCAL_DIR=      # kosong = /tmp/platform-packages (local fallback)
PACKAGES_MINIO_PREFIX=packages

# ── Consul ────────────────────────────────────────────────────────────────────────
CONSUL_ENABLED=false     # true = register ke Consul, butuh Consul running
CONSUL_HOST=127.0.0.1
CONSUL_PORT=8500
CONSUL_TOKEN=
CONSUL_SERVICE_NAME=platform-api
CONSUL_SERVICE_ID=

# ── Auto-scaler ────────────────────────────────────────────────────────────────────
SCALER_ENABLED=false     # true = jalankan background auto-scaler
SCALER_MIN_NODES=1
SCALER_MAX_NODES=10
SCALER_UP_THRESHOLD=0.7
SCALER_DOWN_THRESHOLD=0.3
SCALER_UP_COOLDOWN=300.0
SCALER_DOWN_COOLDOWN=600.0
SCALER_INTERVAL=60.0
SCALER_JOB_ID=fc-agent
SCALER_GROUP=agent
NOMAD_ADDR=http://127.0.0.1:4646
NOMAD_TOKEN=

# ── mTLS ───────────────────────────────────────────────────────────────────────────
MTLS_ENABLED=false       # true = reject request tanpa client cert (HTTP 403)
MTLS_CERT_PATH=/opt/platform/certs/server.crt
MTLS_KEY_PATH=/opt/platform/certs/server.key
MTLS_CA_PATH=/opt/platform/certs/ca.crt

# ── OpenTelemetry ──────────────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=sandbox-platform

# ── Hibernation ────────────────────────────────────────────────────────────────────
HIBERNATE_ENABLED=false
HIBERNATE_IDLE_TIMEOUT=300
HIBERNATE_SCAN_INTERVAL=60
HIBERNATE_TTL=86400      # 24 jam
HIBERNATE_BUCKET=platform-snapshots

# ── Workspace ──────────────────────────────────────────────────────────────────────
WORKSPACE_DRIVER=sync    # sync | async | "" (default: sync)
WORKSPACE_MAX_SIZE_MB=1024
WORKSPACE_BUCKET=platform-workspaces
WORKSPACE_LOCAL_DIR=     # kosong = /tmp/platform-workspaces

# ── Audit ──────────────────────────────────────────────────────────────────────────
AUDIT_BACKEND=stdout     # stdout | postgres | s3
AUDIT_DSN=               # hanya untuk backend=postgres
AUDIT_BUCKET=platform-audit  # hanya untuk backend=s3

# ── Workflow ───────────────────────────────────────────────────────────────────────
WORKFLOW_MAX_STEPS=20
WORKFLOW_MAX_TIMEOUT=600
WORKFLOW_MAX_PARALLEL=5

# ── Streaming ──────────────────────────────────────────────────────────────────────
STREAM_MAX_TIMEOUT=300
STREAM_BUFFER_SIZE=4096

# ── Rate Limiting ──────────────────────────────────────────────────────────────────
RATELIMIT_ENABLED=false
RATELIMIT_BACKEND=memory # memory | redis
DEFAULT_MAX_RPM=30
DEFAULT_MAX_SESSIONS=2

# ── Multi-tenancy ─────────────────────────────────────────────────────────────────
TENANT_ISOLATION=false   # true = wajib X-Tenant-ID header di setiap request
