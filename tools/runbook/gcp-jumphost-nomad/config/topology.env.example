#!/usr/bin/env bash
# topology.env — Platform layer topology config
#
# Salin file ini ke config/topology.env dan isi dengan IP yang sesuai.
# File topology.env di-gitignore agar setiap komputer bisa punya config sendiri.
#
# Usage:
#   cp config/topology.env.example config/topology.env
#   # edit topology.env dengan IP dari: terraform -chdir=terraform output
#   source config/topology.env
#
# Single-server: semua layer pakai IP yang sama.
# Multi-server:  ganti WORKER_HOST / DATA_HOST ke IP berbeda.
#
# Auto-generate dari Terraform output:
#   ./gcloud/gen-topology.sh
#
# ── Layer: controller ─────────────────────────────────────────────────────────
# Services: Nomad (:4646), Consul (:8500), platform-api (:8080)
CONTROLLER_HOST="YOUR_VM_PUBLIC_IP"

# ── Layer: worker ─────────────────────────────────────────────────────────────
# Services: Firecracker agents, FC pool
# Default: sama dengan controller (single-server).
# Ganti ke IP lain untuk split ke server terpisah.
WORKER_HOST="${CONTROLLER_HOST}"

# ── Layer: data ───────────────────────────────────────────────────────────────
# Services: PostgreSQL (:5432), Redis (:6379), MinIO (:9000/:9001), Jaeger (:16686)
# Default: sama dengan controller (single-server).
# Ganti ke IP lain untuk split ke server terpisah.
DATA_HOST="${CONTROLLER_HOST}"

# ── Ports (jarang perlu diganti) ─────────────────────────────────────────────
NOMAD_PORT="${NOMAD_PORT:-4646}"
CONSUL_PORT="${CONSUL_PORT:-8500}"
API_PORT="${API_PORT:-8080}"
MINIO_CONSOLE_PORT="${MINIO_CONSOLE_PORT:-9001}"
MINIO_API_PORT="${MINIO_API_PORT:-9000}"
JAEGER_PORT="${JAEGER_PORT:-16686}"
PG_PORT="${PG_PORT:-5432}"
REDIS_PORT="${REDIS_PORT:-6379}"

# ── GCP config (untuk gcloud commands) ───────────────────────────────────────
PROJECT_ID="${PROJECT_ID:-YOUR_GCP_PROJECT_ID}"
ZONE="${ZONE:-asia-southeast1-a}"
NOMAD_NAME="${NOMAD_NAME:-nomad}"
SSH_USER="${SSH_USER:-$USER}"
